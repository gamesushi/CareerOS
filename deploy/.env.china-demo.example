# ============================================================
# CareerOS · 中国/演示版 环境变量模板（Windows 本地部署用）
# 用法：cp deploy/.env.china-demo.example deploy/.env.production
#       然后逐项替换为真实值（.env.production 已被 .gitignore 忽略，不会入库）
# 启动：docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env.production up -d --build
#
# 相对 .env.production.example 的关键改动：
#   - 关闭 Google 登录（中国被墙），改用 OTP 邮箱验证码
#   - AI 默认走 DeepSeek（国内可达，替代 OpenAI / Gemini）
#   - 其余服务（postgres / redis / minio / docreader / web / worker）保持不变
#   - 公网暴露走 Cloudflare Tunnel，本机 Caddy 用 HTTP 版（见 deploy/Caddyfile.tunnel）
# ============================================================

# ---- 站点 / 证书（隧道模式用不到真实域名，但应用内部链接可能引用，填占位即可）----
SITE_DOMAIN=careeros-demo.local
ACME_EMAIL=admin@example.com

# ---- 数据库 ----
DB_USER=careeros
DB_PASSWORD=请改成强随机串（命令：openssl rand -base64 24）
DB_NAME=careeros

# ---- 对象存储（MinIO 容器内，S3 兼容）----
S3_ACCESS_KEY=careeros
S3_SECRET_KEY=请改成强随机串（命令：openssl rand -base64 24）
S3_BUCKET=careeros-files

# ---- Auth.js ----
# 生成：openssl rand -base64 32
AUTH_SECRET=请改成 openssl rand -base64 32 的输出
# Google 登录在中国不可用，留空即禁用
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# 演示期可临时设 true，允许「账号 + 密码」直接登录（省去 OTP 验证码）。
# ⚠️ 注意：要让它生效，还需把 docker-compose.prod.yml 里 web 服务的
#       「AUTH_DEV_CREDENTIALS: "false"」改为「${AUTH_DEV_CREDENTIALS}」（取消硬编码）。
# 正式上线必须改回 false。
AUTH_DEV_CREDENTIALS=false

# ---- 邮件（OTP 登录 / 找回密码 必需）----
# 用国内可达的 SMTP，例如 QQ 邮箱：
#   SMTP_HOST=smtp.qq.com   SMTP_PORT=587   SMTP_SECURE=false
#   SMTP_USER=你的QQ号@qq.com   SMTP_PASS=QQ邮箱「授权码」（不是登录密码！）
# 也可用 163 / 阿里云邮件推送 / 腾讯云 SES，选国内能连的即可。
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=CareerOS <noreply@example.com>

# ---- WeKnora（可选，留空即用本地 docreader 容器）----
WEKNORA_BASE_URL=
WEKNORA_API_KEY=

# ---- AI Gateway ----
# OpenAI / Gemini 在中国被墙，留空；全部走 DeepSeek
OPENAI_API_KEY=
DEEPSEEK_API_KEY=填你的 DeepSeek API Key
# 模型名按你的账号可用模型填写（模板默认 deepseek-v4-pro；常用 deepseek-chat）
DEEPSEEK_MODEL=deepseek-chat
GEMINI_API_KEY=
AI_DAILY_BUDGET_USD=2
