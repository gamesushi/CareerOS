# CareerOS · Worker (BullMQ + tsx) · 生产镜像
# 架构：linux/arm64（Oracle Ampere A1）
# 注意：worker 用 Playwright 无头 chromium 抓取岗位（boss/liepin 等），需装浏览器与系统库。
FROM node:22-bookworm-slim

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable \
 && corepack prepare pnpm@11.13.1 --activate

WORKDIR /app

# ---------- 1. 依赖 ----------
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml patches/ ./
COPY apps/web/package.json apps/web/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/shared/package.json packages/shared/package.json

RUN pnpm install --frozen-lockfile

# ---------- 2. 源码 ----------
COPY . .

RUN pnpm --filter @careeros/db generate

# ---------- 3. Playwright chromium（岗位抓取必需）----------
# headless.ts 优先用系统 Chrome，找不到则回退到 Playwright 自带 chromium；生产用自带 chromium 最稳。
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      libnss3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libdbus-1-3 \
      libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 \
      libasound2 libpango-1.0-0 libcairo2 libatspi2.0-0 fonts-liberation \
 && rm -rf /var/lib/apt/lists/* \
 && pnpm --filter worker exec playwright install chromium

# ---------- 4b. 本地 OCR 兜底（扫描件 / 退化文字层 PDF）----------
# pdftoppm 把页面渲染成 PNG，tesseract 用 chi_sim+eng 识别。完全离线，不依赖外部 API。
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      poppler-utils tesseract-ocr tesseract-ocr-chi-sim tesseract-ocr-eng \
 && rm -rf /var/lib/apt/lists/*

# ---------- 4. 运行 ----------
# 不用 package.json 里的 --env-file=.env（生产由 compose 注入环境变量），避免容器里缺 .env 文件报错。
ENV NODE_ENV=production
CMD ["pnpm", "--filter", "worker", "exec", "tsx", "src/index.ts"]
