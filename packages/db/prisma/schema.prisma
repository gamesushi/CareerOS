generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, pg_trgm, citext, pgcrypto]
}

// ============ 枚举（与 docs/design/01 DDL 一一对应） ============

enum UserRole {
  guest
  user
  recruiter
  admin
  enterprise

  @@map("user_role")
}

enum JobStatus {
  open
  passive
  closed

  @@map("job_status")
}

enum EntitySource {
  manual
  import
  ai

  @@map("entity_source")
}

enum ImportStatus {
  pending
  parsing
  extracting
  review
  applied
  failed

  @@map("import_status")
}

enum JdStatus {
  pending
  parsing
  parsed
  failed

  @@map("jd_status")
}

enum ResumeType {
  zh
  en
  ja_shokumu
  ja_rirekisho
  linkedin
  cover_letter

  @@map("resume_type")
}

enum ResumeStatus {
  draft
  final
  archived

  @@map("resume_status")
}

enum EvidenceSource {
  project
  experience
  work_log
  achievement
  certificate
  external

  @@map("evidence_source")
}

enum WorklogSource {
  manual
  voice
  email
  notion
  github

  @@map("worklog_source")
}

enum ConnectionType {
  follow
  friend
  colleague

  @@map("connection_type")
}

enum ConnectionStatus {
  pending
  accepted
  blocked

  @@map("connection_status")
}

enum AiRunKind {
  resume_parse
  jd_parse
  resume_generate
  profile_generate
  worklog_summarize
  job_match
  skill_extract
  translate
  writing
  negotiation

  @@map("ai_run_kind")
}

enum AiRunStatus {
  queued
  running
  succeeded
  failed

  @@map("ai_run_status")
}

// 工作授权状态（应聘表单合规字段，如字节/美企岗）
enum WorkAuthStatus {
  us_authorized      // 可在美国无限制工作
  requires_sponsorship // 需要签证赞助/转移
  other

  @@map("work_auth_status")
}

// 语言熟练度
enum LanguageProficiency {
  native            // 母语
  fluent            // 流利
  professional      // 职业级
  conversational    // 日常交流
  basic             // 基础

  @@map("language_proficiency")
}

// ============ 用户与认证（Auth.js Prisma Adapter 标准模型 + 业务字段） ============

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String    @unique @db.Citext
  name          String    @db.VarChar(128)
  emailVerified DateTime? @map("email_verified")
  image         String?   @map("avatar_url")
  role          UserRole  @default(user)
  locale        String    @default("zh") @db.VarChar(8)
  region        String?   @db.VarChar(64)
  // 应聘表单补充字段（对照字节等美企申请）
  mobile         String?   @db.VarChar(64)            // 手机
  preferredCity  String?   @map("preferred_city") @db.VarChar(128) // 意向工作城市
  workAuthStatus WorkAuthStatus? @map("work_auth_status")
  snsLinks       Json      @map("sns_links") @default("[]") // [{ network, url, username }]
  languages      Json      @default("[]")              // [{ name, proficiency }]
  jobStatus     JobStatus @default(passive) @map("job_status")
  privacy       Json      @default("{\"profile_public\": false, \"resume_searchable\": false, \"recruiter_contact\": false, \"feed_visible\": false}")
  weknoraKbId   String?   @map("weknora_kb_id") @db.VarChar(64)
  weknoraApiKey String?   @map("weknora_api_key")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz()
  bannedAt      DateTime? @map("banned_at") @db.Timestamptz() // 管理员封禁：非空即被封，鉴权层即时拒绝
  tosAcceptedAt DateTime? @map("tos_accepted_at") @db.Timestamptz() // 同意《用户协议》《隐私政策》的时间（留痕证据）
  tosVersion    String?   @map("tos_version") @db.VarChar(32)       // 同意的条款版本；与当前版本不一致时登录后强制重新确认
  passwordHash  String?   @map("password_hash") @db.VarChar(255)    // 本地密码登录的 scrypt 哈希；null = 仅 Google/OAuth 登录（无本地密码）

  accounts      Account[]
  sessions      Session[]
  careerProfile CareerProfile?
  experiences   CareerExperience[]
  projects      Project[]
  skills        Skill[]
  achievements  Achievement[]
  educations    Education[]
  honors        Honor[]
  workLogs      WorkLog[]
  resumeImports ResumeImport[]
  jds           JobDescription[]
  jobMatches    JobMatch[]
  resumes       Resume[]
  embeddings    Embedding[]
  aiRuns        AiRun[]
  connectionsFrom Connection[] @relation("ConnFrom")
  connectionsTo   Connection[] @relation("ConnTo")
  jobWatches      JobWatch[]
  discoveredJobs  DiscoveredJob[]
  jobPostings     JobPosting[]    @relation("PostedJobs")
  orgMemberships  OrganizationMember[]
  adminActions    AdminAuditLog[] @relation("AdminActor")
  applications    Application[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model Account {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// 密码找回：每次申请生成一次性 token。DB 仅存 SHA-256 哈希，原始 token 只在重置链接里出现（不落库）。
model PasswordResetToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique // SHA-256(raw token)
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ============ 职业画像与实体 ============

model CareerProfile {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  headline        String?  @db.VarChar(128)
  summary         String?
  // 简历共享个人信息（与每份简历解耦）：证件照 base64、联系地址、日本履历书专用字段。
  personal        Json      @default("{}") @map("personal")
  careerTags      String[] @default([]) @map("career_tags")
  careerLevel     String?  @map("career_level") @db.VarChar(32)
  yearsExperience Decimal? @map("years_experience") @db.Decimal(4, 1)
  industryTags    String[] @default([]) @map("industry_tags")
  isStale         Boolean  @default(true) @map("is_stale")
  generatedRunId  String?  @map("generated_run_id") @db.Uuid
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("career_profiles")
}

model CareerExperience {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  company        String       @db.VarChar(128)
  companyNorm    String       @map("company_norm") @db.VarChar(128)
  title          String       @db.VarChar(128)
  employmentType String?      @map("employment_type") @db.VarChar(32)
  startDate      DateTime     @map("start_date") @db.Date
  endDate        DateTime?    @map("end_date") @db.Date
  location       String?      @db.VarChar(128)
  description    String?
  highlights     String[]     @default([])
  lang           String       @default("zh") @db.VarChar(8)
  source         EntitySource @default(manual)
  importId       String?      @map("import_id") @db.Uuid
  sortOrder      Int          @default(0) @map("sort_order")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz()

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  import       ResumeImport?  @relation(fields: [importId], references: [id], onDelete: SetNull)
  projects     Project[]
  achievements Achievement[]

  @@index([userId, startDate(sort: Desc)])
  @@map("career_experiences")
}

model Project {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  experienceId String?      @map("experience_id") @db.Uuid
  name         String       @db.VarChar(160)
  role         String?      @db.VarChar(128)
  startDate    DateTime?    @map("start_date") @db.Date
  endDate      DateTime?    @map("end_date") @db.Date
  description  String?
  outcome      String?
  links        Json         @default("[]")
  techStack    String[]     @default([]) @map("tech_stack")
  lang         String       @default("zh") @db.VarChar(8)
  source       EntitySource @default(manual)
  importId     String?      @map("import_id") @db.Uuid
  sortOrder    Int          @default(0) @map("sort_order")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt    DateTime?    @map("deleted_at") @db.Timestamptz()

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  experience   CareerExperience? @relation(fields: [experienceId], references: [id], onDelete: SetNull)
  import       ResumeImport?     @relation(fields: [importId], references: [id], onDelete: SetNull)
  achievements Achievement[]
  skills       ProjectSkill[]
  workLogs     WorkLogProject[]

  @@index([userId, startDate(sort: Desc)])
  @@index([experienceId])
  @@map("projects")
}

model Skill {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  name        String       @db.VarChar(80)
  nameNorm    String       @map("name_norm") @db.VarChar(80)
  category    String?      @db.VarChar(48)
  level       Int          @default(0) @db.SmallInt
  levelSource EntitySource @default(manual) @map("level_source")
  firstUsedAt DateTime?    @map("first_used_at") @db.Date
  lastUsedAt  DateTime?    @map("last_used_at") @db.Date
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidences SkillEvidence[]
  projects  ProjectSkill[]
  workLogs  WorkLogSkill[]

  @@unique([userId, nameNorm])
  @@map("skills")
}

model SkillEvidence {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  skillId    String         @map("skill_id") @db.Uuid
  sourceType EvidenceSource @map("source_type")
  sourceId   String?        @map("source_id") @db.Uuid
  note       String?
  url        String?
  weight     Int            @default(1) @db.SmallInt
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz()

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, sourceType, sourceId])
  @@index([sourceType, sourceId])
  @@map("skill_evidences")
}

model Achievement {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  experienceId String?   @map("experience_id") @db.Uuid
  projectId    String?   @map("project_id") @db.Uuid
  title        String    @db.VarChar(200)
  metricValue  Decimal?  @map("metric_value")
  metricUnit   String?   @map("metric_unit") @db.VarChar(32)
  metricText   String?   @map("metric_text") @db.VarChar(120)
  evidence     String?
  occurredAt   DateTime? @map("occurred_at") @db.Date
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  experience CareerExperience? @relation(fields: [experienceId], references: [id], onDelete: SetNull)
  project    Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([experienceId])
  @@index([projectId])
  @@map("achievements")
}

model Education {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  school      String    @db.VarChar(160)
  faculty     String?   @db.VarChar(128) // 学院，如「传媒与人文学院」
  degree      String?   @db.VarChar(64)
  major       String?   @db.VarChar(128)
  startDate   DateTime? @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  gpa         String?   @db.VarChar(16)
  description String?
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("educations")
}

// 荣誉奖项（对照应聘表单 Honor and Awards 区块）
model Honor {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  title       String   @db.VarChar(200)
  issuer      String?  @db.VarChar(160) // 颁发机构
  date        DateTime? @map("date") @db.Date
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("honors")
}

// ============ 工作日志 ============

model WorkLog {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String        @map("user_id") @db.Uuid
  logDate            DateTime      @map("log_date") @db.Date
  title              String        @db.VarChar(200)
  content            String
  tags               String[]      @default([])
  aiSummary          String?       @map("ai_summary")
  aiSuggestions      Json?         @map("ai_suggestions") // { skills: [{name, skillId?}], projectIds: [] } 待用户采纳
  source             WorklogSource @default(manual)
  externalRef        Json?         @map("external_ref")
  weknoraKnowledgeId String?       @map("weknora_knowledge_id") @db.VarChar(64)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt          DateTime?     @map("deleted_at") @db.Timestamptz()

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects WorkLogProject[]
  skills   WorkLogSkill[]

  @@index([userId, logDate(sort: Desc)])
  @@map("work_logs")
}

model WorkLogProject {
  workLogId String @map("work_log_id") @db.Uuid
  projectId String @map("project_id") @db.Uuid

  workLog WorkLog @relation(fields: [workLogId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([workLogId, projectId])
  @@map("work_log_projects")
}

model WorkLogSkill {
  workLogId String @map("work_log_id") @db.Uuid
  skillId   String @map("skill_id") @db.Uuid

  workLog WorkLog @relation(fields: [workLogId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([workLogId, skillId])
  @@map("work_log_skills")
}

model ProjectSkill {
  projectId String @map("project_id") @db.Uuid
  skillId   String @map("skill_id") @db.Uuid

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
  @@map("project_skills")
}

// ============ 导入 / JD / 匹配 / 简历 ============

model ResumeImport {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String       @map("user_id") @db.Uuid
  fileKey            String       @map("file_key")
  fileName           String       @map("file_name") @db.VarChar(255)
  mimeType           String       @map("mime_type") @db.VarChar(128)
  status             ImportStatus @default(pending)
  rawText            String?      @map("raw_text")
  extracted          Json?
  appliedDiff        Json?        @map("applied_diff")
  error              String?
  weknoraKnowledgeId String?      @map("weknora_knowledge_id") @db.VarChar(64)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  experiences CareerExperience[]
  projects    Project[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("resume_imports")
}

model JobDescription {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  company    String?  @db.VarChar(128)
  title      String?  @db.VarChar(160)
  sourceUrl  String?  @map("source_url")
  fileKey    String?  @map("file_key")
  rawContent String   @map("raw_content")
  lang       String?  @db.VarChar(8)
  status     JdStatus @default(pending)
  parsed     Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches        JobMatch[]
  resumes        Resume[]
  discoveredJobs DiscoveredJob[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("job_descriptions")
}

model JobMatch {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jdId               String   @map("jd_id") @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  matchScore         Decimal  @map("match_score") @db.Decimal(5, 2)
  skillCoverage      Decimal  @map("skill_coverage") @db.Decimal(5, 2)
  experienceCoverage Decimal  @map("experience_coverage") @db.Decimal(5, 2)
  industryCoverage   Decimal  @map("industry_coverage") @db.Decimal(5, 2)
  missingSkills      Json     @default("[]") @map("missing_skills")
  matchedEvidence    Json     @default("[]") @map("matched_evidence")
  resumeId           String?  @map("resume_id") @db.Uuid
  runId              String?  @map("run_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz()

  jd     JobDescription @relation(fields: [jdId], references: [id], onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume Resume?        @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  @@index([jdId, createdAt(sort: Desc)])
  @@map("job_matches")
}

model Resume {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  title          String       @db.VarChar(160)
  resumeType     ResumeType   @map("resume_type")
  version        Int          @default(1)
  templateId     String       @default("openresume-classic") @map("template_id") @db.VarChar(64)
  resumeJson     Json         @map("resume_json")
  jdId           String?      @map("jd_id") @db.Uuid
  sourceResumeId String?      @map("source_resume_id") @db.Uuid
  status         ResumeStatus @default(draft)
  pdfFileKey     String?      @map("pdf_file_key")
  generatedAt    DateTime     @default(now()) @map("generated_at") @db.Timestamptz()
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz()

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  jd             JobDescription? @relation(fields: [jdId], references: [id], onDelete: SetNull)
  sourceResume   Resume?         @relation("ResumeDerivation", fields: [sourceResumeId], references: [id], onDelete: SetNull)
  derivedResumes Resume[]        @relation("ResumeDerivation")
  matches        JobMatch[]
  applications   Application[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("resumes")
}

// ============ 岗位监测 ============

enum DiscoveredJobStatus {
  new
  viewed
  imported
  dismissed

  @@map("discovered_job_status")
}

// 用户录入岗位的审核状态：抓取数据默认 approved（信任自动源），
// 用户手动录入/链接导入默认 pending，管理员在 /admin/review 审核。
enum JobReviewStatus {
  pending
  approved
  rejected

  @@map("job_review_status")
}

model JobWatch {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  name            String    @db.VarChar(120)
  keywords        String[]  @default([]) // OR 语义，每个关键词各查一次
  sources         String[]  @default([]) // 适配器 id：tencent / bytedance / ...
  locations       String[]  @default([]) // 城市过滤（适配器内含义各异，见适配器注释）
  matchCategories String[]  @default([]) // 品类匹配：非空时只保留命中品类的岗位（见 sources/lib/category.ts）
  matchRoles      String[]  @default([]) @map("match_roles") // 职种匹配（见 sources/lib/taxonomy.ts）
  matchRegions    String[]  @default([]) @map("match_regions") // 地区匹配：预设 id 或自定义文本
  matchLanguages  String[]  @default([]) @map("match_languages") // 语言匹配：zh/en/ja/ko
  matchExperience String[]  @default([]) @map("match_experience") // 经验级别：junior/mid/senior/lead
  excludeKeywords String[]  @default([]) @map("exclude_keywords") // 硬门槛：title/snippet 命中任一即丢弃（如 外包/派遣/实习）
  maxAgeDays      Int?      @map("max_age_days") // 硬门槛：陈旧过滤，publishedAt 超过 N 天丢弃（无发布时间的不过滤）
  intervalMinutes Int       @default(60) @map("interval_minutes")
  enabled         Boolean   @default(true)
  lastRunAt       DateTime? @map("last_run_at") @db.Timestamptz()
  lastError       String?   @map("last_error")
  lastResult      String?   @map("last_result") // 最近一次抓取结果 JSON：{scanned,created,updated,closed,deleted,found}
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs DiscoveredJob[]

  @@index([enabled, lastRunAt])
  @@map("job_watches")
}

model DiscoveredJob {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  watchId     String              @map("watch_id") @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  source      String              @db.VarChar(32)
  externalId  String              @map("external_id") @db.VarChar(128)
  title       String              @db.VarChar(200)
  company     String?             @db.VarChar(128)
  location    String?             @db.VarChar(128)
  salary      String?             @db.VarChar(64)
  url         String
  snippet     String?             // 职责摘要（列表接口给多少存多少）
  publishedAt DateTime?           @map("published_at") @db.Timestamptz()
  raw         Json?
  categories  Json      @default("[]") @map("categories") // 品类标签数组（游戏/金融/技术…）
  roles       Json      @default("[]") // 职种标签数组（派生自 sources/lib/taxonomy.ts）
  regions     Json      @default("[]") // 地区标签数组（location 归一化）
  languages   Json      @default("[]") // 语言标签数组（JD 文本检测）
  experience  Json      @default("[]") // 经验级别数组（JD 文本检测）
  status      DiscoveredJobStatus @default(new)
  jdId        String?             @map("jd_id") @db.Uuid
  takenDownAt   DateTime? @map("taken_down_at") @db.Timestamptz() // 管理员下架（诈骗/幽灵岗）：非空则不进用户 feed
  takenDownById String?   @map("taken_down_by_id") @db.Uuid       // 下架操作的管理员 id（审计冗余）
  matchScore    Float?    @map("match_score")                     // 岗位↔用户档案 fit 分（0-100，embedding），null=未评分
  matchReasons  Json?     @map("match_reasons")                   // [{ type, label, similarity }] 命中理由
  // 审核流：抓取数据默认 approved；用户录入（source=user/import）写 pending，
  // 过审前不进公共统计/排行榜，仅提交者本人 feed 可见（标「审核中」）。
  reviewStatus   JobReviewStatus @default(approved) @map("review_status")
  reviewedAt     DateTime?       @map("reviewed_at") @db.Timestamptz()
  reviewedById   String?         @map("reviewed_by_id") @db.Uuid   // 审核操作的管理员 id（审计冗余）
  reviewNote     String?         @map("review_note") @db.VarChar(500) // 拒绝理由等备注
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  closedAt    DateTime?           @map("closed_at") @db.Timestamptz() // 停招时间：该次运行未在抓取结果中出现则标记；超 14 天由 worker 清理

  watch JobWatch        @relation(fields: [watchId], references: [id], onDelete: Cascade)
  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  jd    JobDescription? @relation(fields: [jdId], references: [id], onDelete: SetNull)

  @@unique([watchId, source, externalId])
  @@index([userId, status, createdAt(sort: Desc)])
  @@index([reviewStatus, createdAt(sort: Desc)]) // 审核队列扫描
  @@map("discovered_jobs")
}

// ============ B 端雇主发岗（posting-only） ============
// 与 DiscoveredJob 的关键区别：DiscoveredJob 是「每用户私有」的抓取 feed（按 userId 行级隔离），
// JobPosting 是「全局公共」的雇主发布岗，任何候选人都能看到同一批。两者语义不同，故分表。

enum OrgType {
  individual_hr    // HR 个人
  startup          // 创业公司
  non_company_team // 创业团队（未注册主体）
  enterprise       // 预留：大型企业，首期表单不可选（多有自有 ATS，需求弱）

  @@map("org_type")
}

enum JobPostingStatus {
  draft
  open
  closed

  @@map("job_posting_status")
}

enum OrgMemberRole {
  owner     // 建组织的人，唯一能删组织
  admin     // 可改资料、可管成员
  recruiter // 只能发岗 / 管自己的岗

  @@map("org_member_role")
}

// 组织实体（Phase 2）。Phase 1 的岗位只挂在个人名下、company 是自由填写的字符串，
// 同一家公司的两个岗之间没有任何关联；有了 Organization 才能做公司主页与岗位归属。
// 注意：orgId 保持可空——个人 HR 不建组织也要能继续发岗（不破坏 Phase 1 行为）。
model Organization {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String   @unique @db.VarChar(64) // 公开主页 /c/<slug>
  name        String   @db.VarChar(160)
  orgType     OrgType  @map("org_type") // 与 JobPosting.orgType 同一词表
  logoUrl     String?  @map("logo_url")
  website     String?  @db.VarChar(255)
  description String? // 公司介绍，公开主页展示
  industry    String?  @db.VarChar(64)
  size        String?  @db.VarChar(32) // 1-10 / 11-50 / 51-200 / 200+
  location    String?  @db.VarChar(128)
  verified    Boolean  @default(false) // 预留：企业实名认证，首期不强制
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  members  OrganizationMember[]
  postings JobPosting[]

  @@map("organizations")
}

model OrganizationMember {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String        @map("org_id") @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  role      OrgMemberRole @default(recruiter)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz()

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
  @@map("organization_members")
}

model JobPosting {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postedByUserId String           @map("posted_by_user_id") @db.Uuid
  orgId          String?          @map("org_id") @db.Uuid // 预留：将来接 Organization/Company，历史岗不用迁移
  orgType        OrgType          @map("org_type")
  company        String           @db.VarChar(128) // 展示用公司 / 团队名
  title          String           @db.VarChar(200)
  location       String?          @db.VarChar(128)
  salary         String?          @db.VarChar(64)
  description    String // 完整 JD 文本
  url            String? // 外链申请地址；首期无站内投递
  categories     Json             @default("[]") // 品类标签数组，与 DiscoveredJob.categories 同构（game/finance/tech/ai）
  status         JobPostingStatus @default(draft)
  // 治理：复用 DiscoveredJob 同款审核流与下架能力，避免 B 端成为绕过审核的入口
  reviewStatus   JobReviewStatus  @default(pending) @map("review_status")
  reviewedAt     DateTime?        @map("reviewed_at") @db.Timestamptz()
  reviewedById   String?          @map("reviewed_by_id") @db.Uuid // 审核管理员 id（审计冗余）
  reviewNote     String?          @map("review_note") @db.VarChar(500)
  takenDownAt    DateTime?        @map("taken_down_at") @db.Timestamptz() // 管理员下架：非空则不进候选端
  takenDownById  String?          @map("taken_down_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  closedAt       DateTime?        @map("closed_at") @db.Timestamptz() // 发布者主动下架时间

  postedBy User          @relation("PostedJobs", fields: [postedByUserId], references: [id], onDelete: Cascade)
  // SetNull 而非 Cascade：删组织不该连带删岗位，历史岗退化为「个人发布」
  org      Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  @@index([status, reviewStatus, createdAt(sort: Desc)]) // 候选端公共流扫描
  @@index([postedByUserId, createdAt(sort: Desc)]) // 「我的发布」
  @@index([orgId, status, reviewStatus]) // 公司主页岗位列表
  @@map("job_postings")
}

// ============ 社交（预留） / 向量 / 审计 ============

model Connection {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  targetUserId String           @map("target_user_id") @db.Uuid
  type         ConnectionType
  status       ConnectionStatus @default(pending)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  user   User @relation("ConnFrom", fields: [userId], references: [id], onDelete: Cascade)
  target User @relation("ConnTo", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([userId, targetUserId, type])
  @@map("connections")
}

model Embedding {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String                 @map("user_id") @db.Uuid
  sourceType  String                 @map("source_type") @db.VarChar(32)
  sourceId    String                 @map("source_id") @db.Uuid
  contentHash String                 @map("content_hash") @db.VarChar(64)
  modelId     String                 @map("model_id") @db.VarChar(64)
  dimension   Int
  embedding   Unsupported("halfvec")
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sourceType, sourceId, modelId])
  @@index([userId, sourceType])
  @@map("embeddings")
}

model AiRun {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String?     @map("user_id") @db.Uuid
  kind          AiRunKind
  status        AiRunStatus @default(queued)
  inputRef      Json?       @map("input_ref")
  model         String?     @db.VarChar(64)
  promptVersion String?     @map("prompt_version") @db.VarChar(32)
  tokensIn      Int?        @map("tokens_in")
  tokensOut     Int?        @map("tokens_out")
  costUsd       Decimal?    @map("cost_usd") @db.Decimal(10, 6)
  latencyMs     Int?        @map("latency_ms")
  error         String?
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  finishedAt    DateTime?   @map("finished_at") @db.Timestamptz()

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([kind, status])
  @@map("ai_runs")
}

// ============ 管理后台审计 ============

enum AdminAction {
  user_role_change
  user_soft_delete
  user_restore
  user_ban
  job_takedown
  job_review
  source_toggle
  other

  @@map("admin_action")
}

// 管理操作审计：所有 /api/admin 写操作各落一条，只增不改不删。
model AdminAuditLog {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String      @map("actor_id") @db.Uuid
  action     AdminAction
  targetType String      @map("target_type") @db.VarChar(32) // "user" | "discovered_job" | ...
  targetId   String?     @map("target_id") @db.Uuid
  before     Json?       // 变更前快照（脱敏）
  after      Json?       // 变更后快照（脱敏）
  reason     String?     @db.VarChar(500)
  ip         String?     @db.VarChar(64)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz()

  actor User @relation("AdminActor", fields: [actorId], references: [id])

  @@index([actorId, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}

// ============ 登录审计 ============
// 每次登录尝试（成功/失败）各落一条，用于安全审计、异常登录发现、登录速率限制计数。只增不改不删。
model LoginLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  email     String?  @db.Citext
  method    String   @db.VarChar(16) // "google" | "dev" | "password"
  success   Boolean
  reason    String?  @db.VarChar(64) // 失败原因：invalid_email | rate_limited | self_deleted | ...
  ip        String?  @db.VarChar(64)
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([email])
  @@index([userId])
  @@index([createdAt])
  @@map("login_logs")
}

// ============ 申请投递看板（Kanban / 求职 CRM） ============

enum ApplicationStage {
  considering // 想投
  applied     // 已投递
  screening   // 筛选中
  interview   // 面试中
  offer       // Offer
  rejected    // 已结束/被拒

  @@map("application_stage")
}

// 一条投递追踪：从"想投"到"offer/结束"的全流程。字段自包含（快照 title/company 等），
// 即使来源发现岗位变动也不丢。events 存阶段流转/备注时间线。
model Application {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  discoveredJobId String?          @map("discovered_job_id") @db.Uuid // 来源发现岗位（去重用），无关系约束
  jdId            String?          @map("jd_id") @db.Uuid
  resumeId        String?          @map("resume_id") @db.Uuid          // 本次投递用的简历
  title           String           @db.VarChar(200)
  company         String?          @db.VarChar(128)
  location        String?          @db.VarChar(128)
  url             String?
  salary          String?          @db.VarChar(64)
  source          String?          @db.VarChar(32)
  stage           ApplicationStage @default(considering)
  matchScore      Float?           @map("match_score") // 快照
  notes           String?          @db.Text
  nextAction      String?          @map("next_action") @db.VarChar(200)
  nextActionAt    DateTime?        @map("next_action_at") @db.Timestamptz()
  position        Int              @default(0) // 列内排序
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume Resume?            @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  events ApplicationEvent[]

  @@index([userId, stage, position])
  @@index([userId, discoveredJobId])
  @@map("applications")
}

// 申请时间线：创建、阶段流转、备注。
model ApplicationEvent {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String            @map("application_id") @db.Uuid
  kind          String            @db.VarChar(24) // created | stage_change | note
  fromStage     ApplicationStage? @map("from_stage")
  toStage       ApplicationStage? @map("to_stage")
  note          String?           @db.Text
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz()

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt(sort: Desc)])
  @@map("application_events")
}

// ============ 管理后台 P2：灰度开关 + 成本告警 ============

// Feature Flag：灰度开关。enabled 为前提，rolloutPercent 控制放量比例（按 userId 稳定哈希）。
model FeatureFlag {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key            String   @unique @db.VarChar(64)
  description    String?  @db.VarChar(300)
  enabled        Boolean  @default(false)
  rolloutPercent Int      @default(100) @map("rollout_percent") // 0-100
  updatedById    String?  @map("updated_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("feature_flags")
}

// 成本告警配置（单例，固定 id="cost"）：当日 AI 成本超阈值时向 webhook 发一次通知。
model AlertConfig {
  id                String   @id @default("cost") @db.VarChar(32)
  enabled           Boolean  @default(false)
  dailyThresholdUsd Decimal  @default(0) @map("daily_threshold_usd") @db.Decimal(10, 4)
  webhookUrl        String?  @map("webhook_url")
  lastFiredOn       String?  @map("last_fired_on") @db.VarChar(10) // YYYY-MM-DD，当日去重
  updatedById       String?  @map("updated_by_id") @db.Uuid
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("alert_configs")
}
