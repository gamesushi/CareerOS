# ---- Database ----
DATABASE_URL="postgresql://careeros:careeros_dev@localhost:5433/careeros?schema=careeros"

# ---- Redis (BullMQ) ----
REDIS_URL="redis://localhost:6380"

# ---- Object storage (MinIO / S3 兼容) ----
S3_ENDPOINT="http://localhost:9100"
S3_ACCESS_KEY="careeros"
S3_SECRET_KEY="careeros_dev"
S3_BUCKET="careeros-files"

# ---- Auth.js ----
AUTH_SECRET="dev-secret-change-me"          # openssl rand -base64 32
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# 开发期启用密码登录占位（生产关闭）
AUTH_DEV_CREDENTIALS="true"

# ---- WeKnora（Sprint 2 接入） ----
WEKNORA_BASE_URL="http://localhost:8080/api/v1"
WEKNORA_API_KEY=""

# ---- AI Gateway（Sprint 2 接入） ----
OPENAI_API_KEY=""
DEEPSEEK_API_KEY=""
GEMINI_API_KEY=""
AI_DAILY_BUDGET_USD="2"

# ---- Stripe（B 端组织订阅） ----
# 测试用 test 密钥；上线前替换为 live 密钥（Stripe 后台 Developers → API keys）。
STRIPE_SECRET_KEY=""
# Webhook 验签密钥（Stripe 后台 Webhooks → Signing secret）。
# 本地开发用 `stripe listen --forward-to localhost:3000/api/stripe/webhook` 输出的密钥。
STRIPE_WEBHOOK_SECRET=""
# 公开可分发（前端若需；Hosted Checkout 实际不需要，留空亦可）。
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Pro 月费套餐在 Stripe 的 Price ID（Stripe 后台建订阅型 Price 后填入）。
STRIPE_BEND_PRICE_ID=""
# 应用对外 base URL（拼接 Stripe 回跳地址）。生产默认 https://ucareeros.com，开发默认 http://localhost:3000。
APP_BASE_URL=""
